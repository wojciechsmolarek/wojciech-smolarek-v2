---
import BaseLayout from "./BaseLayout.astro";
import Navbar from "../components/Navbar";
import Footer from "../components/Footer.astro";
import Cursor from "../components/Cursor";

interface Props {
    title: string;
    description: string;
    ogImage?: string;
}

const { title, description, ogImage } = Astro.props;
// Normalize pathname: strip ".html" (from build.format: 'file') and collapse "/index" to "/" so Navbar active-state matching works with clean paths
const currentPath = Astro.url.pathname.replace(/\.html$/, "").replace(/^\/index$/, "/");
---

<BaseLayout title={title} description={description} ogImage={ogImage}>
    <Cursor client:idle />
    <Navbar client:idle currentPath={currentPath} />
    <slot />
    <Footer />
</BaseLayout>
