---
import MainLayout from "../layouts/MainLayout.astro";
import Hero from "../components/Hero.astro";
import ServicesHighlight from "../components/ServicesHighlight.astro";
import StatsSection from "../components/StatsSection.astro";
import Expertise from "../components/Expertise.astro";
import Philosophy from "../components/Philosophy.astro";
import Icon from "../components/Icon.astro";
import type { TechItem } from "../types";

const techStack: TechItem[] = [
	{ name: "Search Console", icon: "search" },
	{ name: "Lighthouse", icon: "speed" },
	{ name: "Schema.org", icon: "code" },
	{ name: "GA4", icon: "analytics" },
	{ name: "Screaming Frog", icon: "bug_report" },
	{ name: "Wazuh", icon: "search" },
	{ name: "Chrome DevTools", icon: "code" },
	{ name: "Ahrefs", icon: "analytics" },
	{ name: "Senuto", icon: "trending_up" },
	{ name: "Semrush", icon: "analytics" },
	{ name: "Majestic", icon: "link" },
	{ name: "n8n", icon: "bolt" },
	{ name: "Astro", icon: "bolt" },
	{ name: "Next.js", icon: "code" },
];
---

<MainLayout
	title="Wojciech Smolarek — Technical SEO Specialist | Audyty, logi, migracje"
	description="Sprawdzam w logach, co Googlebot naprawdę robi na Twoim serwisie. Audyt techniczny SEO, crawl budget, dane RUM i nadzór nad migracjami dużych stron."
>
	<main id="main-content">
		<Hero />
		<ServicesHighlight />

		<!-- Segments Strip -->
		<section
			class="py-16 px-6 md:px-12 bg-secondary border-b border-black/10"
			aria-label="Segmenty"
		>
			<div class="max-w-7xl mx-auto">
				<div class="flex flex-wrap justify-center gap-8 md:gap-16 items-center">
					<span class="font-mono text-sm uppercase tracking-widest text-gray-600">E-COMMERCE</span>
					<span class="text-gray-400">·</span>
					<span class="font-mono text-sm uppercase tracking-widest text-gray-600">MARKETPLACE</span>
					<span class="text-gray-400">·</span>
					<span class="font-mono text-sm uppercase tracking-widest text-gray-600">SERWISY CONTENTOWE</span>
					<span class="text-gray-400">·</span>
					<span class="font-mono text-sm uppercase tracking-widest text-gray-600">SPA / HEADLESS</span>
				</div>
			</div>
		</section>

		<StatsSection />
		<Expertise />

		<Philosophy />

		<!-- TechStack Section -->
		<section
			class="py-20 border-b border-black/10"
			aria-label="Stos Technologiczny"
		>
			<div class="max-w-7xl mx-auto px-6 md:px-12">
				<h2
					class="text-center font-mono text-xs uppercase tracking-widest mb-12 text-gray-600"
				>
					Stos Technologiczny
				</h2>
				<div
					class="flex flex-wrap justify-center gap-12 md:gap-24 opacity-60 grayscale hover:grayscale-0 transition-all duration-700"
				>
					{
						techStack.map((tech) => (
							<span class="font-display font-bold text-xl flex items-center gap-2 interactive">
								<Icon name={tech.icon} class="w-6 h-6" />{" "}
								{tech.name}
							</span>
						))
					}
				</div>
			</div>
		</section>
	</main>
</MainLayout>
